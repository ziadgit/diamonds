# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-4-argon).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SHOW_LANDING_PAGE: Toggles the developer-centric OSS landing page on ("true") or boots directly into the Compliance Studio ("false").
NEXT_PUBLIC_SHOW_LANDING_PAGE="true"
